{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maxwell PEQ",
  "mainBinaryName": "MaxwellPEQ",
  "identifier": "io.github.aquaspaces.maxwell-peq",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Maxwell PEQ",
        "width": 1240,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#1e1f22",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
